{
  "name": "aliouswe-nonsense",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run optimize:images",
    "dev": "astro dev",
    "prebuild": "npm run validate:content && npm run optimize:images",
    "build": "astro check && astro build --force && node scripts/validate-built-images.mjs && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node scripts/migrate-legacy.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "sync:avatar": "node scripts/sync-avatar.mjs",
    "validate:content": "node scripts/validate-content.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.3",
    "@astrojs/react": "6.0.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "7.1.3",
    "lucide-react": "1.27.0",
    "matter-js": "0.20.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/matter-js": "^0.20.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "cheerio": "1.2.0",
    "pagefind": "1.5.2",
    "turndown": "7.2.4",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
