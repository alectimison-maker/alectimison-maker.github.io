{
  "name": "aliouswe-nonsense",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run optimize:images",
    "dev": "astro dev",
    "dev:restart": "astro dev stop && astro dev --host 127.0.0.1 --force",
    "prebuild": "npm run validate:content && npm run optimize:images",
    "build": "astro check && astro build --force && node scripts/validate-built-images.mjs && pagefind --site dist",
    "build:site": "astro check && astro build --force && node scripts/validate-built-images.mjs && pagefind --site dist",
    "prepare:deploy": "npm run validate:content && npm run optimize:images",
    "loadtest:opencv": "node scripts/load-test-opencv.mjs",
    "lock:opencv-asset": "npm run optimize:images && node scripts/validate-opencv-asset.mjs --write-lock",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run && npm test --prefix waline-server && npm test --prefix opencv-runner",
    "test:watch": "vitest",
    "migrate": "node scripts/migrate-legacy.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "sync:avatar": "node scripts/sync-avatar.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:opencv-asset": "node scripts/validate-opencv-asset.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/mdx": "7.0.3",
    "@astrojs/react": "6.0.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/view": "6.43.13",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@uiw/react-codemirror": "4.25.11",
    "@waline/client": "^3.15.2",
    "astro": "7.3.4",
    "lucide-react": "1.27.0",
    "matter-js": "0.20.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "sharp": "0.35.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/matter-js": "^0.20.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "cheerio": "1.2.0",
    "pagefind": "1.5.2",
    "turndown": "7.2.4",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
