---
import type { CoffeeArtwork } from '../data/coffee-editorial'

interface Props {
  artwork: CoffeeArtwork
}

const { artwork } = Astro.props

const roundGlyphs = [
  { char: 'R', area: 'r', size: 'xl', turn: '-10deg', shift: '-2%, 3%', stretch: '1.18, 1.06' },
  { char: 'o', area: 'round-o', size: 'm', turn: '13deg', shift: '2%, -2%', stretch: '1.05, 1.14' },
  { char: 'u', area: 'u', size: 'xs', turn: '-12deg', shift: '-4%, 1%', stretch: '1.12, 1.12' },
  { char: 'n', area: 'n', size: 'l', turn: '8deg', shift: '3%, -1%', stretch: '1.1, 1.08' },
  { char: 'd', area: 'd', size: 's', turn: '-11deg', shift: '-3%, 4%', stretch: '1.08, 1.12' },
  { char: 'T', area: 't', size: 'xxl', turn: '7deg', shift: '-2%, 3%', stretch: '1.14, 1.08' },
  { char: 'o', area: 'to-o', size: 's', turn: '-9deg', shift: '3%, -2%', stretch: '1.08, 1.14' },
  { char: 'C', area: 'c', size: 'xl', turn: '9deg', shift: '2%, 1%', stretch: '1.16, 1.06' },
  { char: 'o', area: 'coffee-o', size: 's', turn: '-12deg', shift: '-2%, 3%', stretch: '1.08, 1.12' },
  { char: 'f', area: 'f-one', size: 'xl', turn: '11deg', shift: '3%, -1%', stretch: '1.1, 1.12' },
  { char: 'f', area: 'f-two', size: 'l', turn: '90deg', shift: '115%, -15%', stretch: '1.12, 1.08' },
  { char: 'e', area: 'e-one', size: 's', turn: '-11deg', shift: '1%, -10%', stretch: '1.16, 1.06' },
  { char: 'e', area: 'e-two', size: 'ml', turn: '20deg', shift: '-3%, 3%', stretch: '1.08, 1.14' },
  { char: '?', area: 'question', size: 'xl', turn: '-13deg', shift: '3%, 2%', stretch: '1.12, 1.08' },
] as const
---

{artwork === 'hows-the-coffee' && (
  <span class="title-art title-art--hows" aria-hidden="true">
    <span class="hows-word hows-word--how">How‘s</span>
    <span class="hows-word hows-word--the">the</span>
    <span class="hows-word hows-word--coffee"><b>C</b>offee</span>
  </span>
)}

{artwork === 'round-to-coffee' && (
  <span class="title-art title-art--round" aria-hidden="true">
    {roundGlyphs.map((glyph) => (
      <span class="round-cell" style={`grid-area:${glyph.area}`}>
        <b
          class:list={['round-glyph', `round-glyph--${glyph.size}`, { 'round-glyph--lower': /[a-z]/.test(glyph.char) }]}
          style={`--turn:${glyph.turn};--shift:${glyph.shift};--stretch:${glyph.stretch}`}
        >
          {glyph.char}
        </b>
      </span>
    ))}
  </span>
)}

{artwork === 'four-seasons' && (
  <span class="title-art title-art--four" aria-hidden="true">
    <span class="four-glyph four-glyph--four">四</span>
    <span class="four-glyph four-glyph--order">序</span>
  </span>
)}

{artwork === 'the-room' && (
  <span class="title-art title-art--room" aria-hidden="true">
    <span class="room-the">THE</span>
    <span class="room-word">ROOM</span>
  </span>
)}

{artwork === 'datum' && (
  <span class="title-art title-art--datum" aria-hidden="true">
    <span class="datum-face-wall">
      <span class="datum-face datum-face--one">(^‿^)</span>
      <span class="datum-face datum-face--two">( ´･ω･)</span>
      <span class="datum-face datum-face--three">(｡•́︿•̀｡)</span>
      <span class="datum-face datum-face--four">( ◡‿◡ )</span>
      <span class="datum-face datum-face--five">(っ˘ω˘ς )</span>
      <span class="datum-face datum-face--six">(._.)</span>
      <span class="datum-face datum-face--seven">(￣∇￣)</span>
      <span class="datum-face datum-face--eight">╮(╯▽╰)╭</span>
      <span class="datum-face datum-face--nine">(－_－) zzZ</span>
      <span class="datum-face datum-face--ten">(￣▽￣)旦</span>
      <span class="datum-face datum-face--micro datum-face--eleven">(o_o)</span>
      <span class="datum-face datum-face--micro datum-face--twelve">(¬_¬)</span>
      <span class="datum-face datum-face--micro datum-face--thirteen">(&gt;_&lt;)</span>
      <span class="datum-face datum-face--micro datum-face--fourteen">(^.^)</span>
      <span class="datum-face datum-face--micro datum-face--fifteen">(u_u)</span>
      <span class="datum-face datum-face--micro datum-face--sixteen">(;_;)</span>
      <span class="datum-face datum-face--micro datum-face--seventeen">(°_°)</span>
      <span class="datum-face datum-face--micro datum-face--eighteen">(-.-)</span>
      <span class="datum-face datum-face--micro datum-face--nineteen">(~_~)</span>
      <span class="datum-face datum-face--micro datum-face--twenty">(x_x)</span>
      <span class="datum-face datum-face--nano datum-face--twenty-one">(@_@)</span>
      <span class="datum-face datum-face--nano datum-face--twenty-two">(+_+)</span>
      <span class="datum-face datum-face--nano datum-face--twenty-three">($_$)</span>
      <span class="datum-face datum-face--nano datum-face--twenty-four">(?_?)</span>
      <span class="datum-face datum-face--nano datum-face--twenty-five">(!.!)</span>
      <span class="datum-face datum-face--nano datum-face--twenty-six">(*_*)</span>
      <span class="datum-face datum-face--nano datum-face--twenty-seven">(^o^)</span>
      <span class="datum-face datum-face--nano datum-face--twenty-eight">(T_T)</span>
      <span class="datum-face datum-face--nano datum-face--twenty-nine">(9_9)</span>
      <span class="datum-face datum-face--nano datum-face--thirty">(=_=)</span>
      <span class="datum-face datum-face--micro datum-face--thirty-one">(._.?)</span>
      <span class="datum-face datum-face--nano datum-face--thirty-two">(^_-)</span>
      <span class="datum-face datum-face--micro datum-face--thirty-three">(-_^)</span>
      <span class="datum-face datum-face--nano datum-face--thirty-four">(o.O)</span>
      <span class="datum-face datum-face--micro datum-face--thirty-five">(O.o)</span>
      <span class="datum-face datum-face--nano datum-face--thirty-six">(&gt;_o)</span>
      <span class="datum-face datum-face--micro datum-face--thirty-seven">(._-)</span>
      <span class="datum-face datum-face--nano datum-face--thirty-eight">('~')</span>
      <span class="datum-face datum-face--micro datum-face--thirty-nine">(^-^)</span>
      <span class="datum-face datum-face--nano datum-face--forty">(._&lt;)</span>
      <span class="datum-face datum-face--micro datum-face--forty-one">(&gt;_.)</span>
      <span class="datum-face datum-face--nano datum-face--forty-two">(-o-)</span>
      <span class="datum-face datum-face--extra datum-face--extra-one">(o.O)</span>
      <span class="datum-face datum-face--extra datum-face--extra-two">(O.o)</span>
      <span class="datum-face datum-face--extra datum-face--extra-three">(^_^;)</span>
      <span class="datum-face datum-face--extra datum-face--extra-four">(0_0;)</span>
      <span class="datum-face datum-face--extra datum-face--extra-five">(-_-;)</span>
      <span class="datum-face datum-face--extra datum-face--extra-six">(._.?)</span>
      <span class="datum-face datum-face--extra datum-face--extra-seven">(._&lt;)</span>
      <span class="datum-face datum-face--extra datum-face--extra-eight">(&gt;.&lt;)</span>
      <span class="datum-face datum-face--extra datum-face--extra-nine">(^-^)</span>
      <span class="datum-face datum-face--extra datum-face--extra-ten">(v_v)</span>
      <span class="datum-face datum-face--extra datum-face--extra-eleven">(z_z)</span>
      <span class="datum-face datum-face--extra datum-face--extra-twelve">(._.)?</span>
    </span>
    <span class="datum-cell datum-cell--d">D</span>
    <span class="datum-cell datum-cell--a">a</span>
    <span class="datum-cell datum-cell--t">t</span>
    <span class="datum-cell datum-cell--u">u</span>
    <span class="datum-cell datum-cell--m">m</span>
  </span>
)}

<style>
  @font-face {
    font-family: "Coffee Free Jazz";
    src: url("/fonts/jazz/Kranky/Kranky-Regular.ttf") format("truetype");
    font-display: swap;
  }

  @font-face {
    font-family: "Coffee Zhi Mang Xing";
    src: url("/fonts/coffee/ZhiMangXing/ZhiMangXing-Regular.ttf") format("truetype");
    font-display: swap;
  }

  @font-face {
    font-family: "Coffee Modal Jazz";
    src: url("/fonts/jazz/Fascinate/Fascinate-Regular.ttf") format("truetype");
    font-display: swap;
  }

  @font-face {
    font-family: "Coffee Swing";
    src: url("/fonts/jazz/Limelight/Limelight-Regular.ttf") format("truetype");
    font-display: swap;
  }

  .title-art {
    width: 100%;
    height: 100%;
    min-height: clamp(18rem, 32vw, 30rem);
    display: block;
    position: relative;
    overflow: hidden;
    container-type: size;
    font-family: var(--serif);
  }

  .hows-word { position: absolute; display: block; white-space: nowrap; }
  .hows-word--how {
    z-index: 2;
    top: 50%;
    left: -.08em;
    color: #2350dc;
    font-size: clamp(8rem, 12vw, 12rem);
    font-weight: 800;
    line-height: .72;
    letter-spacing: -.06em;
    writing-mode: vertical-rl;
    text-orientation: sideways;
    transform: translateY(-50%) scaleX(2.85);
    transform-origin: left center;
  }
  .hows-word--the {
    z-index: 1;
    top: -.08em;
    right: -.02em;
    color: #ef3038;
    font-size: clamp(7rem, 11vw, 11rem);
    line-height: .76;
    letter-spacing: -.08em;
    transform: scaleX(2.65);
    transform-origin: right top;
  }
  .hows-word--coffee {
    z-index: 3;
    right: -.035em;
    bottom: .08em;
    color: #006854;
    font-size: clamp(10rem, 17vw, 17rem);
    line-height: .76;
    letter-spacing: -.085em;
    transform: scaleY(1.55);
    transform-origin: right bottom;
  }
  .hows-word--coffee b {
    display: inline-block;
    margin-right: .025em;
    font-weight: 900;
    transform: scaleY(1.08);
    transform-origin: left bottom;
  }

  .title-art--round {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    grid-template-rows: repeat(6, minmax(0, 1fr));
    grid-template-areas:
      "r r r round-o c c c coffee-o"
      "r r r round-o c c c coffee-o"
      "n n t t to-o f-one f-one d"
      "n n t t to-o f-one f-one d"
      "u u t t to-o e-two question question"
      "f-two f-two e-one e-one e-one e-two question question";
    gap: clamp(.02rem, .12cqw, .08rem);
    padding: clamp(.08rem, .28cqw, .22rem);
  }
  .round-cell {
    min-width: 0;
    min-height: 0;
    display: grid;
    place-items: center;
    overflow: visible;
  }
  .round-glyph {
    display: block;
    color: #050505;
    font-family: "Coffee Free Jazz", var(--serif);
    font-size: var(--glyph-size);
    font-weight: 400;
    line-height: .68;
    letter-spacing: -.04em;
    transform: translate(var(--shift)) rotate(var(--turn)) scale(var(--stretch));
  }
  .round-glyph--xxl { --glyph-size: min(36cqw, 40cqh); }
  .round-glyph--xl { --glyph-size: min(30cqw, 34cqh); }
  .round-glyph--l { --glyph-size: min(25cqw, 30cqh); }
  .round-glyph--ml { --glyph-size: min(22cqw, 26cqh); }
  .round-glyph--m { --glyph-size: min(20cqw, 24cqh); }
  .round-glyph--s { --glyph-size: min(16cqw, 18cqh); }
  .round-glyph--xs { --glyph-size: min(13cqw, 14cqh); }
  .round-glyph--lower { font-size: calc(var(--glyph-size) * 1.25); }

  .title-art--four {
    display: grid;
    grid-template: 1fr 1fr / repeat(3, minmax(0, 1fr));
    grid-template-areas: "four four ." ". order order";
    gap: clamp(.08rem, .4cqw, .3rem);
    padding: clamp(.25rem, .8cqw, .6rem);
  }
  .four-glyph {
    min-width: 0;
    min-height: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    color: #111310;
    font-family: "Coffee Zhi Mang Xing", var(--serif);
    font-weight: 400;
    line-height: .72;
  }
  .four-glyph--four {
    grid-area: four;
    font-size: min(39cqw, 47cqh);
    transform: scale(1.28, 1.08) translate(-3%, -1%);
  }
  .four-glyph--order {
    grid-area: order;
    font-size: min(37cqw, 45cqh);
    transform: scale(1.1, 1.16) translate(3%, 1%);
  }

  .title-art--room {
    display: grid;
    grid-template: repeat(10, minmax(0, 1fr)) / repeat(12, minmax(0, 1fr));
    gap: clamp(.04rem, .18cqw, .14rem);
    padding: clamp(.3rem, .8cqw, .7rem);
    font-family: "Coffee Modal Jazz", var(--serif);
  }
  .room-the {
    min-width: 0;
    min-height: 0;
    display: grid;
    overflow: hidden;
  }
  .room-the {
    grid-area: 1 / 1 / 4 / 5;
    place-items: center;
    color: #191812;
    font-size: min(15.6cqw, 21.6cqh);
    line-height: .72;
    letter-spacing: -.06em;
    transform: rotate(3deg) translate(2%, -2%);
  }
  .room-word {
    position: absolute;
    right: 7%;
    bottom: 8%;
    display: block;
    white-space: nowrap;
    color: transparent;
    background: linear-gradient(145deg, #c66a72 4%, #a8495d 50%, #701f3a 96%);
    background-clip: text;
    -webkit-background-clip: text;
    font-size: min(46.2cqw, 55cqh);
    font-weight: 400;
    line-height: .72;
    letter-spacing: -.08em;
    transform: rotate(3deg);
    transform-origin: right bottom;
  }

  .title-art--datum {
    display: grid;
    grid-template: repeat(8, minmax(0, 1fr)) / repeat(12, minmax(0, 1fr));
    gap: clamp(.03rem, .16cqw, .12rem);
    padding: clamp(.35rem, 1cqw, .8rem);
    font-family: "Coffee Swing", var(--serif);
  }
  .datum-face-wall {
    position: absolute;
    z-index: 1;
    inset: 0;
    pointer-events: none;
    font-family: var(--mono);
    font-weight: 500;
    line-height: 1;
  }
  .datum-face {
    position: absolute;
    display: block;
    color: #000;
    white-space: nowrap;
    font-size: clamp(.65rem, 1.8cqw, 1rem);
    transform-origin: center;
  }
  .datum-face--one {
    top: 4%;
    left: 30%;
    opacity: .72;
    font-size: clamp(1rem, 2.6cqw, 1.45rem);
    transform: rotate(-9deg);
  }
  .datum-face--two { top: 32%; left: 16%; opacity: .55; transform: rotate(13deg); }
  .datum-face--three { top: 10%; left: 48%; opacity: .85; transform: rotate(-18deg); }
  .datum-face--four { top: 39%; left: 50%; opacity: .45; transform: rotate(7deg); }
  .datum-face--five { top: 40%; left: 78%; opacity: .68; transform: rotate(-12deg); }
  .datum-face--six { top: 55%; left: 29%; opacity: .9; transform: rotate(19deg); }
  .datum-face--seven { top: 79%; left: 29%; opacity: .58; transform: rotate(-24deg); }
  .datum-face--eight { top: 43%; left: 31%; opacity: .76; transform: rotate(14deg); }
  .datum-face--nine { top: 50%; left: 77%; opacity: .49; transform: rotate(-7deg); }
  .datum-face--ten {
    top: 31%;
    left: 66%;
    opacity: 1;
    font-size: clamp(1rem, 2.6cqw, 1.45rem);
    transform: rotate(11deg);
  }
  .datum-face--micro { font-size: clamp(.5rem, 1.2cqw, .72rem); }
  .datum-face--eleven { top: 34%; left: 3%; opacity: .64; transform: rotate(-16deg); }
  .datum-face--twelve { top: 1%; left: 53%; opacity: .88; transform: rotate(6deg); }
  .datum-face--thirteen { top: 25%; left: 29%; opacity: .47; transform: rotate(17deg); }
  .datum-face--fourteen { top: 28%; left: 52%; opacity: .7; transform: rotate(-21deg); }
  .datum-face--fifteen { top: 45%; left: 94%; opacity: .52; transform: rotate(9deg); }
  .datum-face--sixteen { top: 68%; left: 64%; opacity: .81; transform: rotate(-13deg); }
  .datum-face--seventeen { top: 82%; left: 3%; opacity: .44; transform: rotate(15deg); }
  .datum-face--eighteen { top: 20%; left: 84%; opacity: .74; transform: rotate(-5deg); }
  .datum-face--nineteen { top: 90%; left: 34%; opacity: .59; transform: rotate(22deg); }
  .datum-face--twenty { top: 75%; left: 94%; opacity: .93; transform: rotate(-19deg); }
  .datum-face--nano { font-size: clamp(.42rem, .95cqw, .58rem); }
  .datum-face--twenty-one { top: 11%; left: 3%; opacity: .57; transform: rotate(18deg); }
  .datum-face--twenty-two { top: 2%; left: 43%; opacity: .78; transform: rotate(-14deg); }
  .datum-face--twenty-three { top: 18%; left: 30%; opacity: .42; transform: rotate(8deg); }
  .datum-face--twenty-four { top: 31%; left: 47%; opacity: .91; transform: rotate(-23deg); }
  .datum-face--twenty-five { top: 44%; left: 57%; opacity: .53; transform: rotate(12deg); }
  .datum-face--twenty-six { top: 62%; left: 31%; opacity: .69; transform: rotate(-6deg); }
  .datum-face--twenty-seven { top: 58%; left: 94%; opacity: .84; transform: rotate(21deg); }
  .datum-face--twenty-eight { top: 86%; left: 64%; opacity: .46; transform: rotate(-17deg); }
  .datum-face--twenty-nine { top: 70%; left: 49%; opacity: .75; transform: rotate(5deg); }
  .datum-face--thirty { top: 8%; left: 91%; opacity: .62; transform: rotate(-10deg); }
  .datum-face--thirty-one { top: 1%; left: 61%; opacity: .66; transform: rotate(13deg); }
  .datum-face--thirty-two { top: 1%; left: 69%; opacity: .48; transform: rotate(-9deg); }
  .datum-face--thirty-three { top: 3%; left: 77%; opacity: .76; transform: rotate(18deg); }
  .datum-face--thirty-four { top: 12%; left: 85%; opacity: .57; transform: rotate(-16deg); }
  .datum-face--thirty-five { top: 84%; left: 39%; opacity: .82; transform: rotate(9deg); }
  .datum-face--thirty-six { top: 91%; left: 46%; opacity: .51; transform: rotate(-20deg); }
  .datum-face--thirty-seven { top: 87%; left: 56%; opacity: .7; transform: rotate(15deg); }
  .datum-face--thirty-eight { top: 92%; left: 67%; opacity: .43; transform: rotate(-7deg); }
  .datum-face--thirty-nine { top: 36%; left: 60%; opacity: .88; transform: rotate(-12deg); }
  .datum-face--forty { top: 43%; left: 65%; opacity: .54; transform: rotate(21deg); }
  .datum-face--forty-one { top: 50%; left: 71%; opacity: .73; transform: rotate(-18deg); }
  .datum-face--forty-two { top: 57%; left: 59%; opacity: .46; transform: rotate(8deg); }
  .datum-face--extra { font-size: clamp(.46rem, 1.08cqw, .66rem); }
  .datum-face--extra-one { top: 6%; left: 44%; opacity: .48; transform: rotate(12deg); }
  .datum-face--extra-two { top: 14%; left: 57%; opacity: .7; transform: rotate(-8deg); }
  .datum-face--extra-three { top: 13%; left: 78%; opacity: .56; transform: rotate(19deg); }
  .datum-face--extra-four { top: 16%; left: 83%; opacity: .43; transform: rotate(-17deg); }
  .datum-face--extra-five { top: 35%; left: 55%; opacity: .73; transform: rotate(9deg); }
  .datum-face--extra-six { top: 42%; left: 69%; opacity: .51; transform: rotate(-20deg); }
  .datum-face--extra-seven { top: 45%; left: 74%; opacity: .82; transform: rotate(14deg); }
  .datum-face--extra-eight { top: 58%; left: 55%; opacity: .6; transform: rotate(-11deg); }
  .datum-face--extra-nine { top: 66%; left: 60%; opacity: .46; transform: rotate(21deg); }
  .datum-face--extra-ten { top: 91%; left: 39%; opacity: .76; transform: rotate(-15deg); }
  .datum-face--extra-eleven { top: 93%; left: 57%; opacity: .54; transform: rotate(8deg); }
  .datum-face--extra-twelve { top: 89%; left: 68%; opacity: .67; transform: rotate(-5deg); }
  .datum-cell {
    z-index: 2;
    min-width: 0;
    min-height: 0;
    display: grid;
    place-items: center;
    overflow: visible;
    color: #351b18;
    font-weight: 400;
    line-height: .72;
  }
  .datum-cell--d {
    grid-area: 2 / 1 / 9 / 5;
    place-items: start center;
    font-size: min(43cqw, 54cqh);
    transform: scale(1.08, 2.52) translate(-2%, 0);
    transform-origin: center top;
  }
  .datum-cell--a { grid-area: 2 / 5 / 5 / 7; font-size: min(21cqw, 28cqh); transform: scale(1.08, 1.06) translate(-2%, 2%); }
  .datum-cell--t {
    grid-area: 1 / 6 / 4 / 9;
    position: relative;
    top: -5.25cqh;
    font-size: min(24cqw, 27cqh);
    transform: rotate(-60deg) scale(1.33, 2.2) translate(-1%, 2%);
    transform-origin: center top;
  }
  .datum-cell--u {
    grid-area: 4 / 5 / 9 / 9;
    font-size: min(35cqw, 44cqh);
    transform: scale(1.59) translate(1%, 0);
  }
  .datum-cell--m {
    grid-area: 4 / 9 / 9 / 13;
    position: relative;
    top: -27cqh;
    font-size: min(35cqw, 43cqh);
    transform: scale(1.04, 2.5) translate(-3%, 0);
    transform-origin: center top;
