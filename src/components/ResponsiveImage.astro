---
import imageManifest from '../../public/image-manifest.json'

interface Props {
  src: string
  alt: string
  loading?: 'lazy' | 'eager'
  sizes?: string
  class?: string
}

interface ImageVariant {
  width: number
  webp: string
  avif?: string
}

interface ImageEntry {
  variants: ImageVariant[]
}

const {
  src,
  alt,
  loading = 'lazy',
  sizes = '(max-width: 760px) 50vw, 20vw',
  class: className,
} = Astro.props
const decoded = decodeURI(src)
const extensionIndex = decoded.lastIndexOf('.')
const extension = decoded.slice(extensionIndex).toLowerCase()
const passthrough = extension === '.svg' || extension === '.ico'
const key = decoded.split('/').map((segment) => encodeURIComponent(segment)).join('/')
const variants = (imageManifest as Record<string, ImageEntry>)[key]?.variants ?? []
const webpVariants = variants.filter((variant) => variant.webp)
const avifVariants = variants.filter((variant) => variant.avif)
const fallback = webpVariants.findLast((variant) => variant.width <= 1600) ?? webpVariants.at(-1)
const webpSet = webpVariants.map((variant) => `${variant.webp} ${variant.width}w`).join(', ')
const avifSet = avifVariants.map((variant) => `${variant.avif} ${variant.width}w`).join(', ')
---

{passthrough || !fallback ? (
  <img src={src} alt={alt} loading={loading} decoding="async" class={className} />
) : (
  <picture>
    {avifSet && <source type="image/avif" srcset={avifSet} sizes={sizes} />}
    <source type="image/webp" srcset={webpSet} sizes={sizes} />
    <img
      src={fallback.webp}
      srcset={webpSet}
      sizes={sizes}
      alt={alt}
      loading={loading}
      decoding="async"
      class={className}
    />
  </picture>
)}
