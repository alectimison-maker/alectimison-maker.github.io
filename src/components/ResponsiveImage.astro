---
interface Props {
  src: string
  alt: string
  loading?: 'lazy' | 'eager'
  sizes?: string
  class?: string
}

const {
  src,
  alt,
  loading = 'lazy',
  sizes = '(max-width: 760px) 50vw, 20vw',
  class: className,
} = Astro.props
const decoded = decodeURI(src)
const extensionIndex = decoded.lastIndexOf('.')
const stem = decoded.slice(0, extensionIndex)
const extension = decoded.slice(extensionIndex).toLowerCase()
const passthrough = extension === '.svg' || extension === '.ico'
const widths = [480, 960, 1600, 2560]
const webpSet = widths.map((width) => `${encodeURI(stem)}.w${width}.webp ${width}w`).join(', ')
const avifSet = widths.filter((width) => width >= 960).map((width) => `${encodeURI(stem)}.w${width}.avif ${width}w`).join(', ')
---

{passthrough ? (
  <img src={src} alt={alt} loading={loading} decoding="async" class={className} />
) : (
  <picture>
    <source type="image/avif" srcset={avifSet} sizes={sizes} />
    <source type="image/webp" srcset={webpSet} sizes={sizes} />
    <img
      src={`${encodeURI(stem)}.w1600.webp`}
      srcset={webpSet}
      sizes={sizes}
      alt={alt}
      loading={loading}
      decoding="async"
      class={className}
    />
  </picture>
)}
