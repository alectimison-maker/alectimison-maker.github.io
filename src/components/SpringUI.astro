<script>
  import { sharedFrameScheduler } from '../lib/physics-2d/FixedStepScheduler'

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && localStorage.getItem('aliouswe-motion') !== 'reduced') {
    document.querySelectorAll<HTMLElement>('[data-spring]').forEach((element) => {
      let x = 0
      let y = 0
      let vx = 0
      let vy = 0
      let targetX = 0
      let targetY = 0
      let active = false

      element.addEventListener('pointermove', (event) => {
        const rect = element.getBoundingClientRect()
        targetX = ((event.clientX - rect.left) / rect.width - .5) * 8
        targetY = ((event.clientY - rect.top) / rect.height - .5) * 8
        active = true
      })
      element.addEventListener('pointerleave', () => {
        targetX = 0
        targetY = 0
        active = false
      })
      element.addEventListener('pointerdown', () => element.style.setProperty('--spring-scale', '.96'))
      element.addEventListener('pointerup', () => element.style.setProperty('--spring-scale', '1'))

      sharedFrameScheduler.subscribe((delta) => {
        const stiffness = active ? 150 : 220
        const damping = 24
        vx += ((targetX - x) * stiffness - vx * damping) * delta
        vy += ((targetY - y) * stiffness - vy * damping) * delta
        x += vx * delta
        y += vy * delta
        element.style.setProperty('--spring-x', `${x}px`)
        element.style.setProperty('--spring-y', `${y}px`)
      })
    })
  }
</script>

<style is:global>
  [data-spring] {
    transform: translate3d(var(--spring-x, 0), var(--spring-y, 0), 0) scale(var(--spring-scale, 1));
    will-change: transform;
  }
</style>
