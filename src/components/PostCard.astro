---
import type { CollectionEntry } from 'astro:content'
import { formatDate } from '../lib/site'
import ResponsiveImage from './ResponsiveImage.astro'

interface Props {
  post: CollectionEntry<'posts'>
  featured?: boolean
}

const { post, featured = false } = Astro.props
const { title, description, date, space, tags, cover } = post.data
const useFeaturedCoffeeLockup = featured && post.id === 'hows-the-coffee'
---

<article class:list={['post-card', { featured }]} data-space={space}>
  <div class="post-card__body">
    <div class="post-card__meta">
      <span>{space}</span>
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
    </div>
    <h3 class:list={{ 'featured-coffee-lockup': useFeaturedCoffeeLockup }}>
      <a href={`/posts/${post.id}/`} aria-label={useFeaturedCoffeeLockup ? title : undefined}>
        {useFeaturedCoffeeLockup ? (
          <>
            <span class="featured-title-line featured-title-medium" aria-hidden="true">How‘s</span>
            <span class="featured-title-line featured-title-small" aria-hidden="true">the</span>
            <span class="featured-title-line featured-title-large" aria-hidden="true"><span class="featured-title-capital">C</span>offee</span>
          </>
        ) : title}
      </a>
    </h3>
    {description && <p>{description}</p>}
    <div class="post-card__footer">
      <span>{tags.slice(0, 3).map((tag) => `#${tag}`).join(' · ')}</span>
      <a href={`/posts/${post.id}/`} aria-label={`阅读 ${title}`}>↗</a>
    </div>
  </div>
  {featured && cover && (
    <div class="post-card__media">
      <ResponsiveImage
        src={cover}
        alt={`${title} 配图：鸳鸯dirty`}
        loading="eager"
        sizes="(max-width: 760px) 100vw, 38vw"
        class="post-card__image"
      />
    </div>
  )}
</article>

<style>
  .post-card {
    position: relative;
    min-height: 19rem;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .post-card__body {
    --post-card-pad: clamp(1rem, 2vw, 1.6rem);
    min-width: 0;
    height: 100%;
    padding: var(--post-card-pad);
    display: flex;
    flex-direction: column;
  }
  .post-card.featured {
    min-height: clamp(25rem, 48vw, 39rem);
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(18rem, .65fr);
  }
  .post-card__media {
    min-width: 0;
    padding: clamp(1rem, 2vw, 1.6rem);
    display: grid;
    place-items: center;
    border-left: 1px solid var(--line);
    overflow: hidden;
  }
  .post-card__media :global(picture) { width: 100%; height: 100%; display: block; }
  .post-card__media :global(.post-card__image) { width: 100%; height: 100%; display: block; object-fit: contain; }
  .post-card__meta, .post-card__footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--muted);
    font: 650 .65rem/1.3 var(--mono);
    text-transform: uppercase;
  }
  .post-card__meta span { color: var(--accent); }
  h3 {
    max-width: 17ch;
    margin: auto 0 1rem;
    font: 500 clamp(1.8rem, 4vw, 4rem)/.96 var(--serif);
    letter-spacing: -.04em;
  }
  h3 a { text-decoration: none; }
  h3 a::after { content: ""; position: absolute; inset: 0; }
  h3.featured-coffee-lockup {
    width: calc(100% + var(--post-card-pad) * 2);
    max-width: none;
    min-height: 0;
    margin: .35rem calc(var(--post-card-pad) * -1);
    flex: 1;
    letter-spacing: -.04em;
  }
  .featured-coffee-lockup a {
    width: 100%;
    height: 100%;
    min-height: 24rem;
    display: block;
    position: relative;
    overflow: hidden;
    font-family: var(--serif);
    line-height: .76;
  }
  .featured-title-line { position: absolute; display: block; white-space: nowrap; }
  .featured-title-medium {
    z-index: 2;
    top: 50%;
    left: -.08em;
    color: #2350dc;
    font-size: clamp(8rem, 12vw, 12rem);
    font-weight: 800;
    line-height: .72;
    letter-spacing: -.06em;
    writing-mode: vertical-rl;
    text-orientation: sideways;
    transform: translateY(-50%) scaleX(2.85);
    transform-origin: left center;
  }
  .featured-title-small {
    z-index: 1;
    top: -.08em;
    right: -.02em;
    color: #ef3038;
    font-size: clamp(7rem, 11vw, 11rem);
    letter-spacing: -.08em;
    transform: scaleX(2.65);
    transform-origin: right top;
  }
  .featured-title-large {
    z-index: 3;
    right: -.035em;
    bottom: .08em;
    color: #006854;
    font-size: clamp(10rem, 17vw, 17rem);
    letter-spacing: -.085em;
    transform: scaleY(1.55);
    transform-origin: right bottom;
  }
  .featured-title-capital {
    display: inline-block;
    margin-right: .025em;
    font-weight: 900;
    transform: scaleY(1.08);
    transform-origin: left bottom;
  }
  p { max-width: 42rem; color: var(--muted); line-height: 1.55; }
  .post-card__footer { padding-top: 1rem; border-top: 1px solid var(--line); }
  .post-card__footer a { position: relative; z-index: 1; font-size: 1.2rem; text-decoration: none; }
  @media (max-width: 760px) {
    .post-card.featured { grid-template-columns: minmax(0, 1fr); }
    .featured-coffee-lockup a {
      min-height: 18rem;
    }
    .featured-title-medium { font-size: clamp(6rem, 30vw, 7.5rem); transform: translateY(-50%) scaleX(1.55); }
    .featured-title-small { font-size: clamp(4rem, 20vw, 5rem); transform: scaleX(1.8); }
    .featured-title-large { font-size: clamp(5rem, 26vw, 7rem); transform: scaleY(2.5); }
    .post-card__media { min-height: 28rem; border-top: 1px solid var(--line); border-left: 0; }
  }
</style>
