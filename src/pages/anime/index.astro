---
import BaseLayout from '../../layouts/BaseLayout.astro'
import AnimeInfiniteCanvas from '../../components/anime/AnimeInfiniteCanvas'
import items from '../../data/anime.json'
import details from '../../data/anime-details.json'

const animeItems = items.map((item) => ({
  ...item,
  ...details[item.id as keyof typeof details],
}))
---
<BaseLayout title="Anime" space="anime">
  <AnimeInfiniteCanvas client:load items={animeItems} />
</BaseLayout>

<style is:global>
  html[data-space="anime"],
  html[data-space="anime"] body {
    overflow: hidden;
  }

  html[data-space="anime"] .page-shell {
    min-height: 0;
  }

  html[data-space="anime"] .site-footer {
    display: none;
  }
</style>
