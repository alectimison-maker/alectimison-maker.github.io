---
import type { CollectionEntry } from 'astro:content'
import BaseLayout from './BaseLayout.astro'
import Comments from '../components/Comments.astro'
import { estimateReadingMinutes, formatDate, SITE } from '../lib/site'

interface Props {
  post: CollectionEntry<'posts'>
  headings: Array<{ depth: number; slug: string; text: string }>
  canonical?: string
  previous?: CollectionEntry<'posts'>
  next?: CollectionEntry<'posts'>
  noindex?: boolean
  searchable?: boolean
}

const { post, headings, canonical, previous, next, noindex = false, searchable = true } = Astro.props
const { title, description, date, updatedAt, tags, lang, space } = post.data
const displayLang = lang === 'mixed' ? 'zh-CN' : lang
const readingMinutes = estimateReadingMinutes(post.body)
---

<BaseLayout title={title} description={description} canonical={canonical} image={`/og/${post.id}.png`} type="article" lang={displayLang} space={space} noindex={noindex} searchable={searchable}>
  <article class="article-shell container">
    <header class="article-header">
      <p class="eyebrow">{space} / {date.getFullYear()}</p>
      <h1>{title}</h1>
      <div class="article-meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span>约 {readingMinutes} 分钟阅读</span>
        {updatedAt && updatedAt.getTime() !== date.getTime() && <span>更新于 {formatDate(updatedAt)}</span>}
        {tags.length > 0 && <span>{tags.map((tag) => `#${tag}`).join(' · ')}</span>}
      </div>
    </header>

    <div class="article-grid">
      <div class="article-content prose">
        <slot />
      </div>
      {headings.length > 1 && (
        <aside class="article-toc" data-article-toc>
          <div class="article-toc__header">
            <span>CONTENTS</span>
            <button
              type="button"
              aria-expanded="true"
              aria-controls="article-toc-nav"
              data-toc-toggle
            >隐藏</button>
          </div>
          <nav id="article-toc-nav" aria-label="文章目录" data-toc-nav>
            {headings.filter((heading) => heading.depth <= 3).map((heading) => (
              <a href={`#${heading.slug}`} data-depth={heading.depth}>{heading.text}</a>
            ))}
          </nav>
        </aside>
      )}
    </div>

    <footer class="article-footer">
      <div class="author-strip">
        <img src="/avatar.webp" width="58" height="58" alt="" />
        <div><strong>{SITE.author}</strong><span>{SITE.description}</span></div>
        <a href={SITE.github}>GitHub ↗</a>
      </div>
      <div class="article-actions">
        <button type="button" data-copy-link>复制链接</button>
        <button type="button" data-native-share hidden>分享</button>
      </div>
      <nav class="post-navigation" aria-label="相邻文章">
        {previous ? <a href={`/posts/${previous.id}/`}><span>上一篇</span>{previous.data.title}</a> : <span />}
        {next ? <a href={`/posts/${next.id}/`}><span>下一篇</span>{next.data.title}</a> : <span />}
      </nav>
      <Comments postId={post.id} />
    </footer>
  </article>
</BaseLayout>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-link]')
  copyButton?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(window.location.href)
    copyButton.textContent = '已复制'
  })

  const shareButton = document.querySelector<HTMLButtonElement>('[data-native-share]')
  if (shareButton && navigator.share) {
    shareButton.hidden = false
    shareButton.addEventListener('click', () => navigator.share({ title: document.title, url: window.location.href }))
  }

  const toc = document.querySelector<HTMLElement>('[data-article-toc]')
  const tocGrid = toc?.closest<HTMLElement>('.article-grid')
  const tocNav = toc?.querySelector<HTMLElement>('[data-toc-nav]')
  const tocToggle = toc?.querySelector<HTMLButtonElement>('[data-toc-toggle]')
  const setTocHidden = (hidden: boolean) => {
    if (!toc || !tocGrid || !tocNav || !tocToggle) return
    toc.classList.toggle('is-collapsed', hidden)
    tocGrid.classList.toggle('toc-collapsed', hidden)
    tocNav.hidden = hidden
    tocToggle.textContent = hidden ? '显示目录' : '隐藏'
    tocToggle.setAttribute('aria-expanded', String(!hidden))
    tocToggle.setAttribute('aria-label', hidden ? '显示文章目录' : '隐藏文章目录')
  }
  if (tocToggle) {
    let initiallyHidden = false
    try {
      initiallyHidden = localStorage.getItem('aliouswe-toc-hidden') === 'true'
    } catch {}
    setTocHidden(initiallyHidden)
    tocToggle.addEventListener('click', () => {
      const hidden = tocToggle.getAttribute('aria-expanded') === 'true'
      setTocHidden(hidden)
      try {
        localStorage.setItem('aliouswe-toc-hidden', String(hidden))
      } catch {}
    })
  }

  document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
    const wrapper = document.createElement('div')
    wrapper.className = 'code-block'
    pre.before(wrapper)
    wrapper.append(pre)
    const button = document.createElement('button')
    button.type = 'button'
    button.className = 'code-copy'
    button.textContent = '复制'
    button.setAttribute('aria-label', '复制代码')
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(pre.textContent ?? '')
      button.textContent = '已复制'
      window.setTimeout(() => { button.textContent = '复制' }, 1600)
    })
    wrapper.append(button)
  })
</script>

<style>
  .article-shell { --article-width: 76rem; --article-aside-width: clamp(12rem, 17vw, 15rem); --article-column-gap: clamp(2rem, 4vw, 4rem); padding-block: clamp(3rem, 8vw, 8rem); }
  .article-header { width: min(100%, var(--article-width)); margin-inline: auto; padding-bottom: clamp(2rem, 4vw, 3rem); border-bottom: 1px solid var(--line); }
  .article-header h1 { max-width: 15ch; margin: .7rem 0 1.5rem; font: 550 clamp(3rem, 8vw, 7.5rem)/.92 var(--serif); letter-spacing: -.055em; }
  .article-meta { display: flex; flex-wrap: wrap; gap: .75rem 1.5rem; margin-top: 2rem; color: var(--muted); font: .7rem/1.4 var(--mono); }
  .article-grid { width: min(100%, var(--article-width)); margin-inline: auto; display: grid; grid-template-columns: minmax(0, 1fr) var(--article-aside-width); gap: var(--article-column-gap); padding: clamp(2rem, 3vw, 3rem) 0 clamp(3rem, 7vw, 7rem); transition: grid-template-columns .25s ease, gap .25s ease; }
  .article-grid.toc-collapsed { grid-template-columns: minmax(0, 1fr) auto; gap: 1.25rem; }
  .article-content { min-width: 0; grid-column: 1; }
  .article-toc { position: sticky; top: calc(var(--header-height) + 2rem); max-height: calc(100vh - var(--header-height) - 4rem); height: max-content; border-left: 1px solid var(--line); padding-left: 1.2rem; overflow: auto; }
  .article-toc { grid-column: 2; }
  .article-toc__header { display: flex; align-items: center; justify-content: space-between; gap: .75rem; }
  .article-toc__header > span { color: var(--accent); font: 700 .65rem/1 var(--mono); }
  .article-toc__header button { padding: .25rem 0; border: 0; color: var(--muted); background: transparent; font: .62rem/1 var(--mono); cursor: pointer; }
  .article-toc__header button:hover { color: var(--accent); }
  .article-toc nav { display: grid; gap: .65rem; margin-top: 1rem; }
  .article-toc nav[hidden] { display: none; }
  .article-toc a { color: var(--muted); font-size: .82rem; line-height: 1.35; text-decoration: none; }
  .article-toc a[data-depth="3"] { padding-left: 1rem; }
  .article-toc.is-collapsed { border-left: 0; padding-left: 0; overflow: visible; }
  .article-toc.is-collapsed .article-toc__header > span { display: none; }
  .article-toc.is-collapsed .article-toc__header button { padding: .5rem .65rem; border: 1px solid var(--line); white-space: nowrap; }
  .prose > :global(:first-child) { margin-top: 0; }
  .prose :global(h2), .prose :global(h3), .prose :global(h4), .prose :global(h5), .prose :global(h6) { scroll-margin-top: calc(var(--header-height) + 1.5rem); font-family: var(--serif); line-height: 1.15; }
  .prose :global(h2) { margin: 2.4em 0 .7em; font-size: clamp(2rem, 4vw, 3.5rem); letter-spacing: -.035em; }
  .prose :global(h3) { margin: 2em 0 .6em; font-size: 1.65rem; }
  .prose :global(h4) { margin: 1.8em 0 .55em; font-size: 1.3rem; }
  .prose :global(h5) { margin: 1.65em 0 .5em; font-size: 1.12rem; }
  .prose :global(h6) { margin: 1.5em 0 .45em; font-size: 1rem; }
  .prose :global(p), .prose :global(li) { font: 1.05rem/1.85 var(--serif); }
  .prose :global(p) { margin: 0 0 1.35em; }
  .prose :global(a) { text-decoration-color: var(--accent); text-underline-offset: .2em; }
  .prose :global(blockquote) { margin: 2rem 0; padding: .5rem 1.5rem; border-left: .25rem solid var(--accent); color: var(--muted); }
  .prose :global(.code-block) { position: relative; margin-block: 1.5rem; }
  .prose :global(pre) { margin: 0; padding: 2.5rem 1rem 1rem; overflow: auto; border: 1px solid var(--line); background: #0d1117; }
  .prose :global(.code-copy) { position: absolute; z-index: 1; top: .5rem; right: .5rem; padding: .3rem .55rem; border: 1px solid #455148; color: #d9fff3; background: #151d18; font: .65rem/1 var(--mono); cursor: pointer; }
  .prose :global(code) { font-family: var(--mono); font-size: .86em; }
  .prose :global(:not(pre) > code) { padding: .15em .35em; background: var(--surface); }
  .prose :global(img) { display: block; width: 100%; height: auto; margin: 2rem 0; border: 1px solid var(--line); }
  .prose :global(table) { width: 100%; border-collapse: collapse; overflow: auto; }
  .prose :global(th), .prose :global(td) { padding: .65rem; border: 1px solid var(--line); text-align: left; }
  .article-footer { width: min(100%, var(--article-width)); margin-inline: auto; display: grid; grid-template-columns: minmax(0, 1fr) var(--article-aside-width); column-gap: var(--article-column-gap); }
  .article-footer > * { min-width: 0; grid-column: 1; }
  .article-footer > :global(.comments) { min-width: 0; grid-column: 1; }
  .article-shell:has(.article-grid.toc-collapsed) .article-footer { grid-template-columns: minmax(0, 1fr) auto; column-gap: 1.25rem; }
  .author-strip { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem; padding: 1.5rem 0; border-top: 1px solid var(--line); }
  .author-strip img { border-radius: 50%; }
  .author-strip div { display: grid; gap: .25rem; }
  .author-strip span { color: var(--muted); font-size: .8rem; }
  .author-strip a { font: .7rem/1 var(--mono); }
  .article-actions { display: flex; gap: .75rem; padding: 1rem 0; border-top: 1px solid var(--line); }
  .article-actions button { padding: .6rem .85rem; border: 1px solid var(--line); color: var(--text); background: transparent; }
  .post-navigation { display: grid; grid-template-columns: 1fr 1fr; border-block: 1px solid var(--line); }
  .post-navigation a { padding: 1.5rem 0; font: 1rem/1.35 var(--serif); text-decoration: none; }
  .post-navigation a:last-child { text-align: right; }
  .post-navigation span { display: block; margin-bottom: .35rem; color: var(--muted); font: .65rem/1 var(--mono); }
  @media (max-width: 1100px) {
    .article-grid, .article-grid.toc-collapsed { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .article-footer, .article-shell:has(.article-grid.toc-collapsed) .article-footer { grid-template-columns: minmax(0, 1fr); column-gap: 0; }
    .article-content { grid-column: 1; }
    .article-toc, .article-toc.is-collapsed { position: static; order: -1; max-height: none; border-left: 0; border-block: 1px solid var(--line); padding: 1rem 0; overflow: visible; }
    .article-toc { grid-column: 1; }
    .article-toc.is-collapsed .article-toc__header > span { display: block; }
    .article-toc.is-collapsed .article-toc__header button { padding: .25rem 0; border: 0; }
  }
</style>
